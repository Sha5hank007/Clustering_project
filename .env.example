# ── Camera ──
CAMERA_SOURCE=0                          # 0 = desktop webcam, rtsp://user:pass@ip:554/stream, or path/to/video.mp4
CAMERA_ID=reception_cam                  # logical name stored in sightings table
CAMERA_ROI=                              # empty = full frame, or x1,y1,x2,y2

# ── Detection ──
MODEL_PACK=buffalo_l                     # buffalo_s (fast, less accurate) or buffalo_l (slower, more accurate)
DET_SIZE=320,320                         # detector input resolution (320,320 or 640,640)
DET_THRESHOLD=0.6                        # minimum detection confidence (0.0 - 1.0)
DETECT_INTERVAL=3                        # run detection every Nth frame
FPS_SAMPLE_RATE=5                        # frames to grab per second

# ── Quality Gate ──
MIN_FACE_PX=80                           # minimum face width in pixels
BLUR_THRESHOLD=50.0                      # laplacian variance minimum
MAX_YAW_DEGREES=30                       # reject faces turned beyond this

# ── Tracker ──
MAX_MISSES=15                            # frames without match before track dies
IOU_THRESHOLD=0.3                        # minimum IoU to consider a bbox match
TOP_CROPS_PER_TRACK=5                    # best crops retained per track

# ── Identity ──
MATCH_THRESHOLD=0.5                      # cosine similarity to match existing person
QUERY_THRESHOLD=0.45                     # cosine similarity for owner query (phase 2)
COOLDOWN_HOURS=4                         # suppress duplicate sightings within this window

# ── Storage ──
RETENTION_WINDOW_DAYS=2                  # one best crop per person per N days
CROP_STORAGE_DIR=./data/crops            # where face crops are saved to disk

# ── Database ──
POSTGRES_USER=facetrack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=facetrack
DATABASE_URL=postgresql+asyncpg://postgres:Shashank123@localhost:5432/facetrack

# ── RTSP (ignored when using webcam or file) ──
RTSP_BUFFER_SIZE=1                       # opencv buffer size, keep at 1
RTSP_RECONNECT_DELAY=5                   # seconds before reconnect attempt
RTSP_MAX_RECONNECTS=50                   # give up after this many failures

# ── Models ──
MODEL_DIR=./models

DETECTOR_MODEL=det_10g.onnx
RECOGNIZER_MODEL=w600k_r50.onnx
DEBUG_DISPLAY=true